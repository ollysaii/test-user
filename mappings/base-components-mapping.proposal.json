{
  "status": "awaiting_approval",
  "source": "Prototype UI Library / CORE",
  "target": "shadcn/ui",
  "principles": {
    "responsive": "One code component API; desktop/mobile Figma sets become responsive recipes.",
    "semantics": "Choose the shadcn primitive by behavior and accessibility, not by matching names.",
    "preservation": "Do not rename or rebuild Figma components during the mapping phase."
  },
  "mapping": [
    {"figma":"Button","shadcn":["Button"],"strategy":"extend","complexity":"low"},
    {"figma":"Link Button","shadcn":["buttonVariants","a"],"strategy":"compose","complexity":"low"},
    {"figma":"Icon Button","shadcn":["Button"],"strategy":"extend","complexity":"low"},
    {"figma":"Input","shadcn":["Field","Input","InputGroup"],"strategy":"compose","complexity":"medium"},
    {"figma":"Search","shadcn":["InputGroup","Input"],"strategy":"compose","complexity":"medium"},
    {"figma":"Textarea","shadcn":["Field","Textarea"],"strategy":"compose","complexity":"low"},
    {"figma":"Tab - Text","shadcn":["Tabs"],"strategy":"extend","complexity":"medium"},
    {"figma":"Tab - Filled","shadcn":["Tabs"],"strategy":"extend","complexity":"medium"},
    {"figma":"Toggle","shadcn":["Switch"],"strategy":"compose","complexity":"low"},
    {"figma":"Switcher","shadcn":["ToggleGroup"],"strategy":"compose","complexity":"low"},
    {"figma":"Checkbox","shadcn":["Checkbox","Field"],"strategy":"compose","complexity":"low"},
    {"figma":"Radiobutton","shadcn":["RadioGroup","RadioGroupItem"],"strategy":"compose","complexity":"low"},
    {"figma":"Dropdown","shadcn":["Select","SelectTrigger","SelectContent","SelectItem","Field"],"strategy":"compose","complexity":"medium"},
    {"figma":"Badge","shadcn":["Badge"],"strategy":"extend","complexity":"low"},
    {"figma":"File Upload","shadcn":["Field","Input","Button","Progress"],"strategy":"custom-composition","complexity":"high"}
  ],
  "known_issues": [
    "Code Connect requires an unavailable Figma plan/seat.",
    "Repeated naming and casing inconsistencies require normalization.",
    "Two Tab - Filled sets share the same 1440px name but have different heights.",
    "Mobile visual controls below 44px require larger interactive hit areas in code."
  ]
}
